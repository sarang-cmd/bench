# Calculator build output
/build-cg
/build-fx
/build-cg-push
/*.g1a
/*.g3a

# Native test binaries
/build/

# Python
__pycache__/
*.pyc

# Editor
.vscode
*.sublime-workspace

# Simulator screenshots (only the PNGs are kept)
docs/images/*.ppm

# Node, used only to try a browser locally
node_modules/

# Website (React + Tailwind), built by Vite
site/node_modules/
site/dist/
site/public/images/

# The release build, fetched at deploy time (scripts/fetch-addin.mjs) and the
# diagnostic add-in (scripts/fetch-spike.mjs); both are copied out of dist/,
# which is where the committed bytes live.
site/public/Bench-*.g3a
site/public/Bench-demo-*.zip
site/public/spike.diff

# Intermediates of the WebAssembly build. The two files that matter are copied
# into site/public/sim (see below).
/build-wasm/

# The WebAssembly build IS committed, on purpose (unlike the .g3a above): it is
# ~300 KiB, and Vercel has no C compiler, so the deployed simulator needs the
# bytes in the repository.  tools/wasm/build.sh rewrites it; the worker and the
# WASI shim next to it are hand-written or vendored and always come from
# tools/wasm/.
